@baseurl = http://localhost:8080
@resourceId = c8c04d4c-7c67-4b0f-890c-ce211c22667e
@bookingId = 275d4308-2fc7-4400-b97f-7364c1ab5515

@startTime = 2027-01-10T09:00:00Z
@endTime = 2027-01-10T10:00:00Z

### Register user
POST {{baseurl}}/api/auth/register
Content-Type: application/json

{
  "name": "Admin",
  "email": "admin@poab.be",
  "password": "SuperSecretPassword"
}

### Login user
POST {{baseurl}}/api/auth/login
Content-Type: application/json

{
  "email": "paris@poab.be",
  "password": "SuperSecretPassword"
}

### Create resource
POST {{baseurl}}/api/resources
Content-Type: application/json

{
  "name": "Meeting Room A",
  "description": "First floor meeting room",
  "location": "Floor 1",
  "type": "ROOM"
}

### Get resources
GET {{baseurl}}/api/resources?page=0&size=20

### Get resource by id
GET {{baseurl}}/api/resources/{{resourceId}}

### Update resource
PUT {{baseurl}}/api/resources/{{resourceId}}
Content-Type: application/json

{
  "name": "Updated Meeting Room A",
  "description": "Updated room description",
  "location": "Floor 2",
  "type": "ROOM"
}

### Update resource status
PATCH {{baseurl}}/api/resources/{{resourceId}}/status
Content-Type: application/json

{
  "status": true
}

### Check booking availability
GET {{baseurl}}/booking/availability/{{resourceId}}?startTime={{startTime}}&endTime={{endTime}}

### Create booking
POST {{baseurl}}/booking
Content-Type: application/json

{
  "resourceId": "{{resourceId}}",
  "startTime": "{{startTime}}",
  "endTime": "{{endTime}}",
  "bookingDescription": "Team planning meeting"
}

### Delete booking
DELETE {{baseurl}}/booking/{{bookingId}}